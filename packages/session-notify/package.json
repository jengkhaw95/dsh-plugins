{
  "name": "dsh-session-notify",
  "version": "1.0.0",
  "description": "DSH plugin: play a cuelume cue when the main session finishes a turn or needs your input (subagent sessions stay silent).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "cuelume": "^0.2.2",
    "esbuild": "^0.25.12"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "notification",
    "sound",
    "cuelume"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "private": true
}
