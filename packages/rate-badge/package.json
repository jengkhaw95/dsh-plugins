{
  "name": "dsh-rate-badge",
  "version": "1.0.0",
  "description": "DSH plugin: a session-header badge showing whether DeepSeek's peak or off-peak API pricing window is active, with an on/off setting.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "pricing",
    "peak",
    "off-peak"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "private": true
}
